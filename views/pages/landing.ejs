<script>
/* Scroll animations */
const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
}, { threshold: 0.1 });
document.querySelectorAll('[data-anim]').forEach(el => obs.observe(el));

/* Staggered children */
document.querySelectorAll('.problem-grid, .steps, .features-grid, .numbers-grid, .testis, .faq-stack').forEach(grid => {
    [...grid.children].forEach((child, i) => {
        child.style.transitionDelay = `${i * 80}ms`;
    });
});

/* Counter animation */
function runCounter(el) {
    const target = +el.dataset.counter;
    const suffix = el.dataset.suffix || '';
    const dur    = 1800;
    const fps    = 60;
    const steps  = dur / (1000 / fps);
    const inc    = target / steps;
    let cur = 0;
    const t = setInterval(() => {
        cur += inc;
        if (cur >= target) { cur = target; clearInterval(t); }
        el.textContent = Math.floor(cur).toLocaleString('pt-BR') + suffix;
    }, 1000 / fps);
}
const cntObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
        if (e.isIntersecting) {
            e.target.querySelectorAll('[data-counter]').forEach(runCounter);
            cntObs.unobserve(e.target);
        }
    });
}, { threshold: 0.3 });
document.querySelectorAll('.numbers-grid').forEach(el => cntObs.observe(el));

/* FAQ */
document.querySelectorAll('.faq-item').forEach(item => {
    item.addEventListener('click', () => {
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
        if (!open) item.classList.add('open');
    });
});

/* Nav scroll */
const navEl = document.querySelector('.nav');
window.addEventListener('scroll', () => {
    navEl.style.background = scrollY > 60
        ? 'rgba(240,237,230,0.97)'
        : 'rgba(240,237,230,0.85)';
}, { passive: true });
</script>
