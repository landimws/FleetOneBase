<% page='usuarios' %>

<script>
    window.F1Admin = {
        novoUsuario:    () => window.location.href = '/admin/usuarios/novo',
        editarUsuario:  (id) => window.location.href = `/admin/usuarios/novo?id=${id}`,
        filtrarPorEmpresa: (sel) => {
            const url = sel.value ? `/admin/usuarios?empresaId=${sel.value}` : '/admin/usuarios';
            window.location.href = url;
        },
        toggleStatus: async (id, ativo, btn) => {
            const acao = ativo ? 'desativar' : 'ativar';
            if (!confirm(`Tem certeza que deseja ${acao} este usuário?`)) return;
            btn.disabled = true;
            try {
                const res  = await fetch(`/admin/usuarios/${id}/toggle-status`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) { alert(data.message); window.location.reload(); }
                else { alert('Erro: ' + data.message); btn.disabled = false; }
            } catch (e) { alert('Erro de conexão.'); btn.disabled = false; }
        }
    };
</script>

<!-- Header -->
<div class="adm-filters">
    <div>
        <div class="adm-page-sub">Gerencie acessos e permissões</div>
        <h1 class="adm-page-title">Usuários</h1>
    </div>
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <select class="form-select" id="filtroEmpresa"
            onchange="window.F1Admin.filtrarPorEmpresa(this)"
            style="min-width:200px; font-size:13px;">
            <option value="">Todas as Empresas</option>
            <% empresas.forEach(function(empresa) { %>
                <option value="<%= empresa.id %>" <%= filtroEmpresaId == empresa.id ? 'selected' : '' %>>
                    <%= empresa.nome %>
                </option>
            <% }); %>
        </select>
        <button class="btn-truvex" onclick="window.F1Admin.novoUsuario()">
            <i class="ph ph-plus"></i> Novo Usuário
        </button>
    </div>
</div>

<!-- Table -->
<div class="adm-card">
    <div class="adm-card-header">
        <i class="ph ph-users-three"></i>
        Lista de Usuários
    </div>
    <div style="overflow-x:auto;">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Username</th>
                    <th>Empresa</th>
                    <th>Role</th>
                    <th>Super Admin</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (usuarios && usuarios.length > 0) { %>
                    <% usuarios.forEach(function(usuario) { %>
                        <tr>
                            <td style="color:var(--text-muted); font-size:13px;">#<%= usuario.id %></td>
                            <td>
                                <div style="font-weight:600; color:var(--text-primary);"><%= usuario.nome %></div>
                            </td>
                            <td><code><%= usuario.username %></code></td>
                            <td style="color:var(--text-secondary);">
                                <% if (usuario.Empresa) { %>
                                    <%= usuario.Empresa.nome %>
                                <% } else { %>
                                    <span style="color:var(--text-muted);">—</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge-truvex info"><%= usuario.role %></span>
                            </td>
                            <td>
                                <% if (usuario.isSuperAdmin) { %>
                                    <span class="badge-truvex active">
                                        <i class="ph ph-shield-check"></i> Sim
                                    </span>
                                <% } else { %>
                                    <span style="color:var(--text-muted); font-size:13px;">—</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge-truvex <%= usuario.ativo ? 'active' : 'inactive' %>">
                                    <i class="ph ph-<%= usuario.ativo ? 'check-circle' : 'x-circle' %>"></i>
                                    <%= usuario.ativo ? 'Ativo' : 'Inativo' %>
                                </span>
                            </td>
                            <td>
                                <div style="display:flex; gap:8px;">
                                    <button class="btn-ghost-sm"
                                        onclick="window.F1Admin.editarUsuario('<%= usuario.id %>')"
                                        title="Editar">
                                        <i class="ph ph-pencil-simple"></i>
                                    </button>
                                    <button class="btn-ghost-sm <%= usuario.ativo ? 'danger' : 'success' %>"
                                        onclick="window.F1Admin.toggleStatus('<%= usuario.id %>', <%= usuario.ativo %>, this)"
                                        title="<%= usuario.ativo ? 'Desativar' : 'Ativar' %>">
                                        <i class="ph ph-<%= usuario.ativo ? 'prohibit' : 'check' %>"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align:center; padding:48px 20px; color:var(--text-muted);">
                            <i class="ph ph-users" style="font-size:40px; display:block; margin-bottom:10px; opacity:0.3;"></i>
                            Nenhum usuário encontrado.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>