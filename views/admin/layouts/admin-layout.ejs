<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Painel Administrativo' %> — Truvex Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/admin.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- ⚡ Anti-FOUC: tema + sem transições iniciais -->
    <script>
        (function() {
            var t = localStorage.getItem('truvex-admin-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
            // Bloqueia transições até a página estar pronta
            document.documentElement.classList.add('no-transition');
        })();
    </script>

    <style>
    /* Bloqueia TODAS as transições no carregamento inicial (anti-flash) */
    .no-transition *, .no-transition *::before, .no-transition *::after {
        transition: none !important;
        animation: none !important;
    }

    /* ============================================================
       DUAL THEME — CSS CUSTOM PROPERTIES
    ============================================================ */
    :root,
    [data-theme="dark"] {
        --green:         #00C278;
        --green-dark:    #007A4D;
        --green-glow:    rgba(0,194,120,0.15);

        --bg:            #0D0D10;
        --surface:       #111116;
        --surface-2:     #18181E;
        --border:        rgba(255,255,255,0.07);
        --border-strong: rgba(255,255,255,0.12);

        --text-primary:  #F0EDE6;
        --text-secondary:#A1A1AA;
        --text-muted:    #52525E;

        --input-bg:      rgba(0,0,0,0.3);
        --hover-bg:      rgba(255,255,255,0.04);
        --active-bg:     rgba(0,194,120,0.10);

        --red:           rgba(239,68,68,0.1);
        --red-text:      #f87171;
        --red-border:    rgba(239,68,68,0.2);

        --yellow:        rgba(234,179,8,0.08);
        --yellow-text:   #d97706;
        --yellow-border: rgba(234,179,8,0.2);

        --blue:          rgba(59,130,246,0.08);
        --blue-text:     #60a5fa;
        --blue-border:   rgba(59,130,246,0.15);

        --sidebar-w:     240px;
    }

    [data-theme="light"] {
        --bg:            #F5F4F0;
        --surface:       #FFFFFF;
        --surface-2:     #F0EDE6;
        --border:        rgba(0,0,0,0.08);
        --border-strong: rgba(0,0,0,0.15);

        --text-primary:  #0E0E0E;
        --text-secondary:#555248;
        --text-muted:    #999080;

        --input-bg:      #FFFFFF;
        --hover-bg:      rgba(0,0,0,0.03);
        --active-bg:     rgba(0,194,120,0.08);

        --red:           rgba(239,68,68,0.07);
        --red-text:      #dc2626;
        --red-border:    rgba(239,68,68,0.15);

        --yellow:        rgba(234,179,8,0.07);
        --yellow-text:   #92400e;
        --yellow-border: rgba(234,179,8,0.18);

        --blue:          rgba(59,130,246,0.06);
        --blue-text:     #1d4ed8;
        --blue-border:   rgba(59,130,246,0.12);
    }

    /* ============================================================
       BASE
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--bg);
        color: var(--text-primary);
        margin: 0;
        -webkit-font-smoothing: antialiased;
        transition: background 0.3s, color 0.3s;
    }

    /* ============================================================
       SIDEBAR
    ============================================================ */
    .adm-sidebar {
        position: fixed;
        top: 0; left: 0;
        height: 100vh;
        width: var(--sidebar-w);
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        z-index: 100;
        transition: background 0.3s, border-color 0.3s;
    }

    .adm-brand {
        padding: 22px 20px 18px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }
    .adm-logo {
        font-family: 'Epilogue', sans-serif;
        font-weight: 900;
        font-size: 22px;
        letter-spacing: -1.5px;
        color: var(--text-primary);
        display: block;
        margin-bottom: 5px;
    }
    .adm-logo span { color: var(--green); }

    .adm-badge {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--green);
        background: var(--active-bg);
        border: 1px solid rgba(0,194,120,0.2);
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .adm-nav {
        flex: 1;
        padding: 12px 10px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .adm-nav-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--text-muted);
        padding: 12px 10px 6px;
    }

    .adm-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.18s;
        border: 1px solid transparent;
    }
    .adm-link i { font-size: 18px; flex-shrink: 0; }
    .adm-link:hover { background: var(--hover-bg); color: var(--text-primary); }
    .adm-link.active {
        background: var(--active-bg);
        color: var(--green);
        border-color: rgba(0,194,120,0.15);
    }
    .adm-link.danger { color: var(--red-text); }
    .adm-link.danger:hover { background: var(--red); }

    .adm-nav-footer {
        padding: 10px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    /* ============================================================
       TOPBAR
    ============================================================ */
    .adm-topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 14px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 50;
        transition: background 0.3s, border-color 0.3s;
    }

    .adm-topbar-title {
        font-family: 'Epilogue', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .adm-topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Theme Toggle */
    .theme-toggle {
        width: 36px; height: 36px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-secondary);
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        transition: all 0.2s;
    }
    .theme-toggle:hover { border-color: var(--green); color: var(--green); }

    .adm-user {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: var(--text-secondary);
    }
    .adm-avatar {
        width: 32px; height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700;
        font-size: 13px;
        color: #000;
    }

    /* ============================================================
       LAYOUT
    ============================================================ */
    .adm-main {
        margin-left: var(--sidebar-w);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    .adm-content { flex: 1; padding: 28px 32px; }

    /* ============================================================
       CARDS
    ============================================================ */
    .adm-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: background 0.3s, border-color 0.3s;
    }
    .adm-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 14px;
        color: var(--text-primary);
    }
    .adm-card-header i { color: var(--green); font-size: 20px; }

    /* KPI Cards */
    .adm-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    @media (max-width: 1100px) { .adm-kpi-grid { grid-template-columns: repeat(2,1fr); } }
    @media (max-width: 600px)  { .adm-kpi-grid { grid-template-columns: 1fr; } }

    .adm-kpi {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px;
        transition: background 0.3s;
    }
    .adm-kpi-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--text-muted);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .adm-kpi-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
    }
    .adm-kpi-value {
        font-family: 'Epilogue', sans-serif;
        font-size: 36px;
        font-weight: 900;
        letter-spacing: -1.5px;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 6px;
    }
    .adm-kpi-sub { font-size: 13px; color: var(--text-muted); }
    .adm-kpi-sub .up   { color: var(--green); font-weight: 600; }
    .adm-kpi-sub .down { color: var(--red-text); font-weight: 600; }

    /* ============================================================
       TABLES
    ============================================================ */
    .adm-table { width: 100%; border-collapse: collapse; }
    .adm-table thead th {
        padding: 12px 20px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
        white-space: nowrap;
    }
    .adm-table tbody td {
        padding: 15px 20px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text-primary);
        vertical-align: middle;
    }
    .adm-table tbody tr:last-child td { border-bottom: none; }
    .adm-table tbody tr:hover td { background: var(--hover-bg); }

    /* ============================================================
       BUTTONS
    ============================================================ */
    .btn-truvex {
        background: var(--green);
        color: #000;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-family: 'Epilogue', sans-serif;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(0,194,120,0.2);
    }
    .btn-truvex:hover { background: #00d985; transform: translateY(-1px); color: #000; box-shadow: 0 4px 16px rgba(0,194,120,0.3); }

    .btn-ghost-sm {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        text-decoration: none;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .btn-ghost-sm:hover         { border-color: var(--border-strong); color: var(--text-primary); }
    .btn-ghost-sm.danger:hover  { border-color: var(--red-text); color: var(--red-text); background: var(--red); }
    .btn-ghost-sm.success:hover { border-color: var(--green); color: var(--green); background: var(--active-bg); }
    .btn-ghost-sm.warn          { color: var(--yellow-text); border-color: var(--yellow-border); }
    .btn-ghost-sm.warn:hover    { background: var(--yellow); }

    /* ============================================================
       BADGES
    ============================================================ */
    .badge-truvex {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }
    .badge-truvex.active   { background: var(--active-bg); color: var(--green); border: 1px solid rgba(0,194,120,0.2); }
    .badge-truvex.inactive { background: var(--red); color: var(--red-text); border: 1px solid var(--red-border); }
    .badge-truvex.neutral  { background: var(--hover-bg); color: var(--text-muted); border: 1px solid var(--border); }
    .badge-truvex.info     { background: var(--blue); color: var(--blue-text); border: 1px solid var(--blue-border); }

    /* ============================================================
       FILTERS ROW
    ============================================================ */
    .adm-filters {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .adm-page-title {
        font-family: 'Epilogue', sans-serif;
        font-weight: 800;
        font-size: 26px;
        letter-spacing: -1px;
        color: var(--text-primary);
        margin: 0;
    }
    .adm-page-sub {
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 3px;
    }

    /* ============================================================
       BOOTSTRAP OVERRIDES (modals, forms)
    ============================================================ */
    .modal-content {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        color: var(--text-primary);
    }
    .modal-header { border-bottom: 1px solid var(--border); background: var(--surface-2); }
    .modal-footer { border-top: 1px solid var(--border); }
    .modal-title  { font-family: 'Epilogue', sans-serif; font-weight: 700; font-size: 16px; color: var(--text-primary); }
    .btn-close    { filter: invert(1) opacity(0.4); }
    [data-theme="light"] .btn-close { filter: none; }

    .form-control, .form-select {
        background: var(--input-bg);
        border: 1px solid var(--border-strong);
        color: var(--text-primary);
        border-radius: 8px;
        transition: background 0.3s, border-color 0.2s;
    }
    .form-control:focus, .form-select:focus {
        background: var(--input-bg);
        border-color: var(--green);
        box-shadow: 0 0 0 3px var(--green-glow);
        color: var(--text-primary);
    }
    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }
    .input-group .btn {
        border: 1px solid var(--border-strong);
        color: var(--text-muted);
        background: var(--surface-2);
    }
    .input-group .btn:hover { color: var(--text-primary); }

    .alert { border-radius: 10px !important; border: 1px solid; }
    .alert-warning { background: var(--yellow) !important; color: var(--yellow-text) !important; border-color: var(--yellow-border) !important; }
    .alert-info    { background: var(--blue)   !important; color: var(--blue-text)   !important; border-color: var(--blue-border)   !important; }
    .alert-danger  { background: var(--red)    !important; color: var(--red-text)    !important; border-color: var(--red-border)    !important; }

    /* Code */
    code {
        background: var(--surface-2);
        color: var(--green);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 2px 7px;
        font-size: 12px;
    }

    /* Progress bar */
    .adm-progress {
        height: 6px;
        background: var(--border);
        border-radius: 100px;
        overflow: hidden;
    }
    .adm-progress-bar {
        height: 100%;
        background: var(--green);
        border-radius: 100px;
        transition: width 0.6s;
    }
    </style>
</head>

<body>
    <!-- ===== SIDEBAR ===== -->
    <aside class="adm-sidebar">
        <div class="adm-brand">
            <span class="adm-logo">Tru<span>v</span>ex<span>.</span></span>
            <span class="adm-badge">Super Admin</span>
        </div>

        <nav class="adm-nav">
            <div class="adm-nav-label">Principal</div>
            <a href="/admin" class="adm-link <%= (page === 'dashboard') ? 'active' : '' %>">
                <i class="ph ph-squares-four"></i><span>Dashboard</span>
            </a>
            <a href="/admin/empresas" class="adm-link <%= (page === 'empresas') ? 'active' : '' %>">
                <i class="ph ph-buildings"></i><span>Empresas</span>
            </a>
            <a href="/admin/usuarios" class="adm-link <%= (page === 'usuarios') ? 'active' : '' %>">
                <i class="ph ph-users-three"></i><span>Usuários</span>
            </a>
            <a href="/admin/planos" class="adm-link <%= (page === 'admin_planos') ? 'active' : '' %>">
                <i class="ph ph-tag"></i><span>Planos</span>
            </a>
        </nav>

        <div class="adm-nav-footer">
            <a href="/app" class="adm-link">
                <i class="ph ph-arrow-square-left"></i><span>Voltar ao Sistema</span>
            </a>
            <a href="/logout" class="adm-link danger">
                <i class="ph ph-sign-out"></i><span>Sair</span>
            </a>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <div class="adm-main">

        <!-- Topbar -->
        <header class="adm-topbar">
            <div class="adm-topbar-title"><%= title || 'Painel Administrativo' %></div>

            <div class="adm-topbar-right">
                <!-- Theme Toggle -->
                <button class="theme-toggle" id="themeToggle" title="Alternar tema">
                    <i class="ph ph-moon" id="themeIcon"></i>
                </button>

                <div class="adm-user">
                    <span style="font-size:13px;"><%= locals.user?.nome || 'Administrador' %></span>
                    <div class="adm-avatar">
                        <%= locals.user?.nome ? locals.user.nome.charAt(0).toUpperCase() : 'A' %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="adm-content">
            <%- body %>
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/admin/js/utils.js"></script>
    <script src="/admin/js/admin-main.js"></script>

    <script>
    // ===== DUAL THEME TOGGLE =====
    (function() {
        const html = document.documentElement;
        const btn  = document.getElementById('themeToggle');
        const icon = document.getElementById('themeIcon');

        function syncIcon() {
            const theme = html.getAttribute('data-theme') || 'dark';
            icon.className = theme === 'dark' ? 'ph ph-sun' : 'ph ph-moon';
            btn.title = theme === 'dark' ? 'Alternar para modo claro' : 'Alternar para modo escuro';
        }

        syncIcon();

        btn.addEventListener('click', () => {
            const next = (html.getAttribute('data-theme') || 'dark') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('truvex-admin-theme', next);
            syncIcon();
        });

        // Remove no-transition APÓS o primeiro frame pintado — sem flash, com transições nas interações
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                html.classList.remove('no-transition');
            });
        });
    })();
    </script>

    <%- script %>
</body>
</html>