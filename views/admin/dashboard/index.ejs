<% page='dashboard' %>

<!-- KPIs -->
<div class="adm-filters" style="margin-bottom: 24px;">
    <div>
        <div class="adm-page-sub">Visão geral da plataforma</div>
        <h1 class="adm-page-title">Dashboard</h1>
    </div>
</div>

<div class="adm-kpi-grid">
    <div class="adm-kpi">
        <div class="adm-kpi-label">
            Total de Empresas
            <div class="adm-kpi-icon" style="background: var(--active-bg); color: var(--green);">
                <i class="ph ph-buildings"></i>
            </div>
        </div>
        <div class="adm-kpi-value"><%= kpis.totalEmpresas %></div>
        <div class="adm-kpi-sub"><span class="up">↑ 100%</span> desde o início</div>
    </div>

    <div class="adm-kpi">
        <div class="adm-kpi-label">
            Empresas Ativas
            <div class="adm-kpi-icon" style="background: var(--active-bg); color: var(--green);">
                <i class="ph ph-check-circle"></i>
            </div>
        </div>
        <div class="adm-kpi-value"><%= kpis.empresasAtivas %></div>
        <div class="adm-kpi-sub"><span class="down"><%= kpis.empresasCanceladas %></span> canceladas</div>
    </div>

    <div class="adm-kpi">
        <div class="adm-kpi-label">
            MRR Estimado
            <div class="adm-kpi-icon" style="background: var(--blue); color: var(--blue-text);">
                <i class="ph ph-currency-dollar"></i>
            </div>
        </div>
        <div class="adm-kpi-value" style="font-size:28px;">
            <small style="font-size:14px; font-weight:600; color:var(--text-muted);">R$</small>
            <%= kpis.mrr.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
        </div>
        <div class="adm-kpi-sub">Ticket: <strong>R$ <%= kpis.ticketMedio.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong></div>
    </div>

    <div class="adm-kpi">
        <div class="adm-kpi-label">
            Usuários Totais
            <div class="adm-kpi-icon" style="background: var(--yellow); color: var(--yellow-text);">
                <i class="ph ph-users-three"></i>
            </div>
        </div>
        <div class="adm-kpi-value"><%= kpis.totalUsuarios %></div>
        <div class="adm-kpi-sub">Em todas as empresas</div>
    </div>
</div>

<!-- Bottom Row -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">

    <!-- Distribuição de Planos -->
    <div class="adm-card">
        <div class="adm-card-header">
            <i class="ph ph-tag"></i>
            Distribuição de Planos
        </div>
        <div style="padding: 20px;">
            <% if (Object.keys(distribuicaoPlanos).length > 0) { %>
                <% Object.keys(distribuicaoPlanos).forEach(plano => {
                    const qtd = distribuicaoPlanos[plano];
                    const pct = (qtd / (kpis.empresasAtivas || 1) * 100).toFixed(1);
                %>
                <div style="margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                        <span style="font-size:14px; font-weight:600; color:var(--text-primary);"><%= plano %></span>
                        <span style="font-size:13px; color:var(--text-muted);"><%= qtd %> empresa<%= qtd !== 1 ? 's' : '' %> &nbsp;·&nbsp; <strong style="color:var(--text-secondary)"><%= pct %>%</strong></span>
                    </div>
                    <div class="adm-progress">
                        <div class="adm-progress-bar" style="width: <%= pct %>%;"></div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div style="text-align:center; padding: 40px 0; color: var(--text-muted);">
                    <i class="ph ph-tag" style="font-size:36px; display:block; margin-bottom:10px; opacity:0.3;"></i>
                    Nenhum plano ativo encontrado.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Próximas métricas -->
    <div class="adm-card" style="display:flex; align-items:center; justify-content:center;">
        <div style="text-align: center; padding: 40px;">
            <div style="width:64px; height:64px; border-radius:16px; background:var(--surface-2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; margin: 0 auto 16px;">
                <i class="ph ph-chart-line-up" style="font-size:28px; color:var(--text-muted);"></i>
            </div>
            <div style="font-family:'Epilogue',sans-serif; font-weight:700; font-size:16px; color:var(--text-secondary); margin-bottom:6px;">Mais métricas em breve</div>
            <div style="font-size:13px; color:var(--text-muted); max-width:200px;">Gráficos de crescimento e churn serão adicionados aqui.</div>
        </div>
    </div>

</div>